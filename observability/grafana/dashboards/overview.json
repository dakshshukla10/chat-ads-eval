{
  "uid": "chat-ads-eval-overview",
  "title": "Chat Ads Eval - Overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "chat-ads-eval"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "p95 latency",
      "description": "95th percentile of POST /v1/ads/contextual latency. Empty until the service receives traffic.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/v1/ads/contextual\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Token cost",
      "description": "LLM tokens per hour by direction. Stays at zero until an LLM call exists (planned, Phase 3/4); dollar cost needs a price table that is not defined yet.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction) (increase(chatads_llm_tokens_total[1h]))",
          "legendFormat": "{{direction}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Fallback rate",
      "description": "Share of requests answered with no ad.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(chatads_fallback_total[5m])) / clamp_min(sum(rate(chatads_requests_total[5m])), 1e-9)",
          "legendFormat": "fallback"
        }
      ]
    }
  ]
}
