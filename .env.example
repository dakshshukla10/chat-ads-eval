# Copy to .env (git-ignored) and fill in. Nothing here is a real credential.
# The service does not read this file by itself: load it into your shell first,
#   set -a; source .env; set +a

# docker-compose.yml
POSTGRES_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me

# Service
PORT=8080

# Hybrid retrieval. Leave CHATADS_DB_URL empty to run on the in-memory keyword retriever only.
# With docker compose running: jdbc:postgresql://localhost:5432/chatads (same password as POSTGRES_PASSWORD)
# A hosted database can use the string its dashboard shows, e.g.
# postgresql://user:password@host/db?sslmode=require (user and password are read from it).
CHATADS_DB_URL=
CHATADS_DB_USER=chatads
CHATADS_DB_PASSWORD=
CHATADS_DB_POOL_SIZE=4
CHATADS_DB_CONNECT_TIMEOUT=PT1S

# Redis cache for retrieval candidates (needs the redis container from docker compose).
CHATADS_CACHE_ENABLED=false
CHATADS_CACHE_TTL=PT10M
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
# Hosted Redis with TLS and a password: set this instead of host and port.
# SPRING_DATA_REDIS_URL=rediss://default:<password>@<host>:6379
CHATADS_REDIS_TIMEOUT=250ms
CHATADS_REDIS_CONNECT_TIMEOUT=250ms

# Public demo: SPRING_PROFILES_ACTIVE=demo forces the offline embedder, hides /actuator/prometheus
# and limits each client address to 30 requests a minute on /v1/. CHATADS_RATE_LIMIT_PER_MINUTE
# works without the profile too (0 = off).
# SPRING_PROFILES_ACTIVE=demo
CHATADS_RATE_LIMIT_PER_MINUTE=0

# Embeddings. hash is the offline default. For a real model set openai or ollama.
# Example for Ollama after `ollama pull all-minilm`:
#   CHATADS_EMBEDDING_PROVIDER=ollama
#   CHATADS_EMBEDDING_BASE_URL=http://localhost:11434
#   CHATADS_EMBEDDING_MODEL=all-minilm
#   CHATADS_EMBEDDING_DIMENSIONS=384
#   CHATADS_MIN_SIMILARITY=0.4
CHATADS_EMBEDDING_PROVIDER=hash
CHATADS_EMBEDDING_DIMENSIONS=256
CHATADS_EMBEDDING_BASE_URL=
CHATADS_EMBEDDING_MODEL=
CHATADS_EMBEDDING_API_KEY=

# Eval runner
EVAL_BASE_URL=http://localhost:8080

# LLM-as-judge. Leave both empty to skip the judge step.
# Local example: LLM_JUDGE_BASE_URL=http://localhost:11434/v1 and LLM_JUDGE_MODEL=qwen2.5:1.5b-instruct
LLM_JUDGE_BASE_URL=
LLM_JUDGE_MODEL=
LLM_JUDGE_API_KEY=
